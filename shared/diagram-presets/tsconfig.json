{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "flitter-ui": ["../../packages/flitter/src/index.ts"],
      "flitter-ui/diagram": ["../../packages/flitter/src/diagram.ts"],
      "flitter-diagram/engine": ["../../packages/diagram/src/engine.ts"],
      "flitter-core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["index.ts", "flow-diagram/**/*.ts", "xyflow-*/**/*.ts"]
}

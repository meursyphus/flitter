{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "flitterjs": [
        "../../packages/core/src/index.ts"
      ],
      "@flitterjs/diagram": [
        "../../packages/diagram/src/engine.ts"
      ]
    }
  },
  "include": [
    "index.ts",
    "flow-diagram/**/*.ts"
  ]
}

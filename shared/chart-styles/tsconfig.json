{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@headless/*": ["../../packages/chart/src/headless/*"],
      "@shared/*": ["../../packages/chart/src/shared/*"],
      "@utils/*": ["../../packages/chart/src/shared/utils/*"],
      "@styles/*": ["./styles/*"]
    }
  },
  "include": ["index.ts", "charts/**/*", "styles/**/*"]
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "flitter-core/component/Tooltip": ["../../packages/core/src/component/Tooltip.ts"],
      "flitter-core": ["../../packages/core/src/index.ts"],
      "flitter-ui/chart": ["../../packages/flitter/src/chart.ts"],
      "flitter-chart": ["../../packages/chart/src/index.ts"],
      "flitter-chart/*": ["../../packages/chart/src/*"],
      "shared": ["../../dev/shared/index.ts"],
      "shared/chart": ["../../dev/shared/chart.ts"],
      "chart-presets": ["../../shared/chart-presets/index.ts"],
      "chart-presets/*": ["../../shared/chart-presets/*"],
      "@headless/*": ["../../packages/chart/src/headless/*"],
      "@shared/*": ["../../packages/chart/src/shared/*"],
      "@utils/*": ["../../packages/chart/src/shared/utils/*"]
    }
  },
  "include": ["src"]
}

{
  "name": "@flitterjs/svelte",
  "version": "0.0.2",
  "private": false,
  "type": "module",
  "description": "Svelte integration for Flitter — Mount high-performance Canvas/SVG widgets and charts in Svelte applications with SSR support.",
  "keywords": [
    "flitter",
    "svelte",
    "data-visualization",
    "svg",
    "canvas",
    "charts",
    "rendering-engine",
    "svelte-component",
    "flutter-like",
    "ssr",
    "interactive-charts",
    "typescript"
  ],
  "homepage": "https://ui.flitter.dev/integration/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/flitter.git",
    "directory": "integrations/svelte"
  },
  "bugs": {
    "url": "https://github.com/meursyphus/flitter/issues"
  },
  "author": "meursyphus",
  "license": "MIT",
  "main": "./src/lib/index.ts",
  "publishConfig": {
    "main": "./package/index.js",
    "types": "./package/index.d.ts",
    "access": "public"
  },
  "files": ["package"],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "linkedom": "^0.14.21"
  },
  "peerDependencies": {
    "flitter-ui": "workspace:^*",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^1.0.0",
    "@sveltejs/kit": "^1.0.0",
    "@sveltejs/package": "^1.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}

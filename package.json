{
  "name": "flitter-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Flitter monorepo",
  "scripts": {
    "build": "turbo build",
    "build:core": "turbo build --filter=flitter-core",
    "build:chart": "turbo build --filter=flitter-chart",
    "build:flitter": "turbo build --filter=flitter",
    "llm:build": "pnpm --dir docs llm:build",
    "llm:kit": "node docs/scripts/llm-kit.mjs",
    "llm:playground:dev": "pnpm llm:build && node dev/llm-playground/server.mjs",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "docs:dev": "turbo dev --filter=flitter-docs",
    "docs:build": "turbo build --filter=flitter-docs",
    "story:dev": "turbo dev --filter=flitter-storybook",
    "chart-story:dev": "turbo dev --filter=chart-storybook",
    "chart-story:validate": "pnpm --dir dev/performance exec playwright test --config playwright.chart-storybook.config.ts tests/chart-storybook-llm-evaluation.spec.ts",
    "perf:dev": "turbo dev --filter=flitter-performance",
    "test": "turbo test --filter=flitter-performance",
    "test:integration": "pnpm --filter flitter-performance test:integration",
    "chromatic": "turbo build --filter=flitter-storybook^... && pnpm --filter flitter-storybook chromatic"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@10.29.3"
}

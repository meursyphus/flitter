---
import { getCollection } from "astro:content";
import { processEntries, sortEntries, groupEntriesByNavGroup } from "../../utils/collection";

const tutorials = await getCollection("tutorial");
const { currentSlug } = Astro.props;
const [lang] = currentSlug.split("/");

// Process, filter, and sort tutorials using the common utility
const processedTutorials = processEntries(tutorials, { 
  filterLang: lang,
  resolveSlug: true 
});
const sortedTutorials = sortEntries(processedTutorials);

// Group tutorials by nav_group
const groupedTutorials = groupEntriesByNavGroup(sortedTutorials);
---

<div class="p-3 text-sm dark:bg-white">
  {
    Object.entries(groupedTutorials).map(([group, tutorials]) => (
      <div class="mb-6">
        <h3 class="mb-2 text-[16px] font-medium text-[rgb(75,85,99)]">
          {group}
        </h3>
        <ul class="space-y-2.5">
          {tutorials.map((tutorial) => (
            <li>
              <a
                href={`/tutorial/${tutorial.slug}`}
                class:list={[
                  "block rounded px-2 py-1.5 text-[14px] transition-colors",
                  currentSlug === tutorial.slug
                    ? "bg-gray-800 font-medium text-[rgb(209,213,219)]"
                    : "text-[rgb(156,163,175)] hover:text-[rgb(209,213,219)]",
                ]}
              >
                {tutorial.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

{
  "name": "@meursyphus/flitter-vue",
  "private": false,
  "version": "0.0.1",
  "description": "Vue integration for Flitter rendering engine",
  "keywords": [
    "flitter",
    "vue",
    "graphics",
    "canvas",
    "svg",
    "flutter-like",
    "rendering",
    "ui"
  ],
  "homepage": "https://flitter.dev",
  "repository": "https://github.com/meursyphus/flitter",
  "bugs": {
    "url": "https://github.com/meursyphus/flitter/issues"
  },
  "license": "MIT",
  "author": "meursyphus",
  "type": "module",
  "main": "src/lib/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/flitter-vue.js",
      "require": "./dist/flitter-vue.umd.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@meursyphus/flitter": "*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && npm run copy-package && npm run copy-readme && cd dist && npm run fix-package",
    "copy-package": "cp package.json dist/package.json",
    "copy-readme": "cp README.md dist/README.md",
    "fix-package": "npm pkg set main=./flitter-vue.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@meursyphus/flitter": "^2.1.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^3.9.1",
    "vue-tsc": "^2.2.8"
  }
}

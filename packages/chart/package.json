{
  "name": "@flitterjs/chart",
  "version": "0.1.0",
  "type": "module",
  "description": "Chart library built on Flitter framework",
  "scripts": {
    "build": "vite build && node ../../scripts/fix-declaration-imports.mjs dist",
    "lint": "eslint . --ext ts,tsx",
    "registry:validate": "node ./registry/validate.mjs",
    "prepublishOnly": "node ./registry/validate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4",
    "vite-tsconfig-paths": "^4.3.2",
    "flitterjs": "workspace:*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": "./registry/index.mjs",
    "./registry/*": "./registry/*"
  },
  "files": [
    "dist",
    "registry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "flitterjs": "^1.0.0"
  },
  "license": "MIT",
  "author": "meursyphus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/flitter.git",
    "directory": "packages/chart"
  },
  "homepage": "https://ui.flitter.dev/chart/"
}

{
  "name": "@flitterjs/diagram",
  "version": "0.1.0",
  "type": "module",
  "description": "Node-based diagram editor for Flitter with React Flow interaction semantics",
  "scripts": {
    "build": "vite build && node ../../scripts/fix-declaration-imports.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src registry/templates --ext ts",
    "registry:validate": "node ./registry/validate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4",
    "flitterjs": "workspace:*"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": "./registry/index.mjs",
    "./registry/*": "./registry/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "registry"
  ],
  "peerDependencies": {
    "flitterjs": "^1.0.0"
  },
  "license": "MIT",
  "author": "meursyphus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/flitter.git",
    "directory": "packages/diagram"
  },
  "homepage": "https://ui.flitter.dev/diagram/"
}

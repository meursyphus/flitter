{
  "name": "flitter-diagram",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Node-based diagram editor for Flitter with React Flow interaction semantics",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext ts",
    "registry:validate": "node ./registry/validate.mjs"
  },
  "dependencies": {
    "flitter-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "import": "./src/engine.ts",
      "default": "./src/engine.ts"
    },
    "./registry": "./registry/index.mjs",
    "./registry/*": "./registry/*"
  },
  "publishConfig": {
    "main": "./dist/flitter-diagram.es.js",
    "module": "./dist/flitter-diagram.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/flitter-diagram.es.js",
        "default": "./dist/flitter-diagram.es.js"
      }
    }
  },
  "files": [
    "dist",
    "registry"
  ]
}

{
  "name": "@flitterjs/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Install editable Flitter chart and diagram source templates.",
  "bin": {
    "flitter": "./cli/index.mjs"
  },
  "keywords": [
    "flitter",
    "rendering-engine",
    "data-visualization",
    "svg",
    "canvas",
    "flutter-like",
    "javascript",
    "charts",
    "ui-framework",
    "declarative",
    "interactive",
    "graphics",
    "typescript"
  ],
  "homepage": "https://ui.flitter.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meursyphus/flitter.git"
  },
  "bugs": {
    "url": "https://github.com/meursyphus/flitter/issues"
  },
  "author": "meursyphus",
  "license": "MIT",
  "scripts": {
    "test:install": "pnpm run build && node ./scripts/check-chart-install.mjs && node ./scripts/check-diagram-install.mjs",
    "build": "node ./scripts/sync-cli-registry.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "flitterjs": "workspace:*",
    "@flitterjs/chart": "workspace:*",
    "typescript": "^5.3.3",
    "@flitterjs/diagram": "workspace:*"
  },
  "files": [
    "cli",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  }
}

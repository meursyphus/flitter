{
  "name": "flitter-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Flitter - A high-performance JavaScript rendering engine inspired by Flutter",
  "keywords": ["rendering-engine", "data-visualization", "svg", "canvas", "flutter-like"],
  "homepage": "https://flitter.dev",
  "repository": "https://github.com/meursyphus/flitter",
  "license": "MIT",
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "flitter-core": "workspace:*",
    "flitter-chart": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js",
      "require": "./dist/chart.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  }
}

{
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "flitter-ui/chart": ["../../../flitter/src/chart.ts"],
      "@headless/*": ["../../src/headless/*"],
      "@shared/*": ["../../src/shared/*"],
      "@utils/*": ["../../src/shared/utils/*"],
      "@styles/*": ["./styles/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "styles/**/*.ts",
    "charts/*/base/**/*.ts",
    "charts/*/types.ts",
    "charts/*/plugin.ts",
    "charts/*/styles/*/parts/**/*.ts"
  ]
}

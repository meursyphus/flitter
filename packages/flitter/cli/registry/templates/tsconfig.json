{
  "extends": "../../../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "flitter-ui/chart": [
        "../../../src/chart.ts"
      ],
      "@headless/*": [
        "../../../../chart/src/headless/*"
      ],
      "@shared/*": [
        "../../../../chart/src/shared/*"
      ],
      "@utils/*": [
        "../../../../chart/src/shared/utils/*"
      ],
      "@styles/*": [
        "../../../../chart/registry/templates/styles/*"
      ]
    }
  },
  "include": [
    "shared/**/*.ts",
    "styles/**/*.ts",
    "charts/*/base/**/*.ts",
    "charts/*/types.ts",
    "charts/*/plugin.ts",
    "charts/*/styles/*/parts/**/*.ts"
  ]
}

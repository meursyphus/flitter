{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "experimentalDecorators": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "flitterjs/component/Tooltip": [
        "../packages/core/src/component/Tooltip.ts"
      ],
      "flitterjs": [
        "../packages/core/src/index.ts"
      ],
      "@/components/diagram/flow-diagram/*": [
        "../shared/diagram-presets/flow-diagram/*"
      ],
      "@/components/diagram/flow-diagram": [
        "../shared/diagram-presets/flow-diagram/index.ts"
      ],
      "@flitterjs/chart": [
        "../packages/chart/src/index.ts"
      ],
      "@flitterjs/chart/*": [
        "../packages/chart/src/*"
      ],
      "@flitterjs/diagram": [
        "../packages/diagram/src/index.ts"
      ],
      "shared": [
        "../dev/shared/index.ts"
      ],
      "shared/chart": [
        "../dev/shared/chart.ts"
      ],
      "chart-presets": [
        "../shared/chart-presets/index.ts"
      ],
      "chart-presets/*": [
        "../shared/chart-presets/*"
      ],
      "@headless/*": [
        "../packages/chart/src/headless/*"
      ],
      "@shared/*": [
        "../packages/chart/src/shared/*"
      ],
      "@utils/*": [
        "../packages/chart/src/shared/utils/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
